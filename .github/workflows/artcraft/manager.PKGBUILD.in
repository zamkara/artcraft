pkgname=artcraft
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Install and update native Artcraft creative apps on Arch Linux'
arch=('x86_64')
url='https://github.com/zamkara/artcraft'
license=('LicenseRef-Almatera-Incubator')
depends=('glibc' 'gcc-libs' 'pacman' 'sudo' 'ca-certificates')
makedepends=('rust')
options=('!lto' '!debug')
_commit=@SHA@
source=(@SOURCE@)
sha256sums=(@CHECKSUM@)

_build_env() {
  export CARGO_TARGET_DIR="$startdir/.cache/target"
  export CARGO_HOME="$startdir/.cache/cargo"
  export CARGO_BUILD_JOBS=2
  export RUSTFLAGS='-C target-cpu=x86-64'
  export ARTCRAFT_PKGVER="$pkgver-$pkgrel"
}
build() {
  cd "$srcdir/artcraft-$_commit/.github/workflows/artcraft/cli"
  _build_env
  cargo build --release --locked
}
check() {
  cd "$srcdir/artcraft-$_commit/.github/workflows/artcraft/cli"
  _build_env
  cargo test --release --locked
  "$CARGO_TARGET_DIR/release/artcraft" --help
  "$CARGO_TARGET_DIR/release/artcraft" --version
}
package() {
  _build_env
  install -Dm755 "$CARGO_TARGET_DIR/release/artcraft" "$pkgdir/usr/bin/artcraft"
  install -Dm644 "$srcdir/artcraft-$_commit/LICENSE" "$pkgdir/usr/share/licenses/artcraft/LICENSE"
  install -Dm644 "$srcdir/artcraft-$_commit/.github/workflows/artcraft/cli/README.md" "$pkgdir/usr/share/doc/artcraft/README.md"
}
